// Prisma schema for IAMS — Internal Audit Management System
// PostgreSQL datasource configured via DATABASE_URL env var.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Authentication & Authorization ----

model User {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String
  lastName     String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userRoles UserRole[]

  ownedAuditEntities   AuditUniverse[] @relation("AuditUniverseOwner")
  createdAuditEntities AuditUniverse[] @relation("AuditUniverseCreator")
  updatedAuditEntities AuditUniverse[] @relation("AuditUniverseUpdater")

  ownedRisks      Risk[]       @relation("RiskOwner")
  createdRisks    Risk[]       @relation("RiskCreator")
  updatedRisks    Risk[]       @relation("RiskUpdater")
  assignedActions RiskAction[] @relation("RiskActionAssignee")

  approvedAuditPlans AuditPlan[] @relation("AuditPlanApprover")
  leadAuditPlans     AuditPlan[] @relation("AuditPlanLeadAuditor")
  createdAuditPlans  AuditPlan[] @relation("AuditPlanCreator")
  updatedAuditPlans  AuditPlan[] @relation("AuditPlanUpdater")

  leadEngagements       Engagement[]           @relation("EngagementLeadAuditor")
  createdEngagements    Engagement[]           @relation("EngagementCreator")
  updatedEngagements    Engagement[]           @relation("EngagementUpdater")
  closedEngagements     Engagement[]           @relation("EngagementClosedBy")
  engagementMemberships EngagementTeamMember[] @relation("EngagementTeamMember")

  @@index([email])
  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([name])
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---- Audit Logging ----

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  category  String
  userId    String?  @db.Uuid
  ip        String?
  userAgent String?
  metadata  Json?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

// ---- Audit Universe ----

enum AuditEntityType {
  ORGANIZATION
  DIVISION
  DEPARTMENT
  PROCESS
  SUB_PROCESS
  SYSTEM
  PROJECT
  THIRD_PARTY
  LOCATION
}

enum AuditEntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model AuditUniverse {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique
  name            String
  description     String?
  entityType      AuditEntityType
  status          AuditEntityStatus @default(ACTIVE)
  parentId        String?           @db.Uuid
  businessProcess String?
  department      String?
  riskRating      String?
  notes           String?

  ownerId     String? @db.Uuid
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   AuditUniverse?  @relation("AuditUniverseHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AuditUniverse[] @relation("AuditUniverseHierarchy")

  owner     User? @relation("AuditUniverseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User? @relation("AuditUniverseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AuditUniverseUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  risks       Risk[]
  auditPlans  AuditPlan[]
  engagements Engagement[]

  @@index([parentId])
  @@index([entityType])
  @@index([status])
  @@index([name])
  @@index([ownerId])
}

// ---- Risk Assessment ----

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  MONITORING
  CLOSED
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model Risk {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  auditEntityId String  @db.Uuid

  // Inherent risk assessment
  inherentLikelihood Int       @default(1) // 1-5 scale
  inherentImpact     Int       @default(1) // 1-5 scale
  inherentScore      Int       @default(1) // likelihood * impact
  inherentLevel      RiskLevel @default(LOW)

  // Existing controls assessment
  existingControls     String?
  controlEffectiveness Int     @default(0) // 0-100 percentage

  // Residual risk (calculated)
  residualScore Int       @default(1)
  residualLevel RiskLevel @default(LOW)

  status       RiskStatus @default(OPEN)
  riskCategory String?
  notes        String?

  ownerId     String? @db.Uuid
  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Cascade)
  owner       User?         @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("RiskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("RiskUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  actions     RiskAction[]
  auditPlans  AuditPlan[]  @relation("AuditPlanRisk")
  engagements Engagement[] @relation("EngagementRisk")

  @@index([auditEntityId])
  @@index([status])
  @@index([inherentLevel])
  @@index([residualLevel])
  @@index([ownerId])
  @@index([title])
}

model RiskAction {
  id          String       @id @default(uuid()) @db.Uuid
  riskId      String       @db.Uuid
  title       String
  description String?
  assigneeId  String?      @db.Uuid
  dueDate     DateTime?
  completedAt DateTime?
  status      ActionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  risk     Risk  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  assignee User? @relation("RiskActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([riskId])
  @@index([status])
  @@index([dueDate])
  @@index([assigneeId])
}

// ---- Audit Planning ----

enum AuditPlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuditPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model AuditPlan {
  id            String  @id @default(uuid()) @db.Uuid
  title         String
  reference     String  @unique
  fiscalYear    Int
  auditEntityId String  @db.Uuid
  riskId        String? @db.Uuid

  objectives String
  scope      String
  priority   AuditPriority   @default(MEDIUM)
  status     AuditPlanStatus @default(DRAFT)

  proposedStartDate DateTime?
  proposedEndDate   DateTime?
  approvedAt        DateTime?
  approvedById      String?   @db.Uuid

  leadAuditorId String? @db.Uuid
  notes         String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Restrict)
  risk        Risk?         @relation("AuditPlanRisk", fields: [riskId], references: [id], onDelete: SetNull)
  approvedBy  User?         @relation("AuditPlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  leadAuditor User?         @relation("AuditPlanLeadAuditor", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("AuditPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("AuditPlanUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  engagements Engagement[]

  @@index([auditEntityId])
  @@index([riskId])
  @@index([status])
  @@index([priority])
  @@index([fiscalYear])
  @@index([leadAuditorId])
  @@index([title])
}

// ---- Audit Engagements ----

enum EngagementStatus {
  PLANNED
  ASSIGNED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum EngagementType {
  INTERNAL_AUDIT
  COMPLIANCE_AUDIT
  IT_AUDIT
  OPERATIONAL_AUDIT
  FINANCIAL_AUDIT
  FOLLOW_UP
  SPECIAL_REVIEW
  AD_HOC
}

model Engagement {
  id            String  @id @default(uuid()) @db.Uuid
  reference     String  @unique
  title         String
  auditPlanId   String? @db.Uuid
  auditEntityId String  @db.Uuid
  riskId        String? @db.Uuid

  type   EngagementType   @default(INTERNAL_AUDIT)
  status EngagementStatus @default(PLANNED)

  objectives  String
  scope       String
  methodology String?

  leadAuditorId   String?   @db.Uuid
  startDate       DateTime?
  endDate         DateTime?
  actualStartDate DateTime?
  actualEndDate   DateTime?
  closedAt        DateTime?
  closedById      String?   @db.Uuid
  closureNotes    String?

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditPlan   AuditPlan?    @relation(fields: [auditPlanId], references: [id], onDelete: SetNull)
  auditEntity AuditUniverse @relation(fields: [auditEntityId], references: [id], onDelete: Restrict)
  risk        Risk?         @relation("EngagementRisk", fields: [riskId], references: [id], onDelete: SetNull)
  leadAuditor User?         @relation("EngagementLeadAuditor", fields: [leadAuditorId], references: [id], onDelete: SetNull)
  closedBy    User?         @relation("EngagementClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("EngagementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?         @relation("EngagementUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  teamMembers EngagementTeamMember[]

  @@index([auditPlanId])
  @@index([auditEntityId])
  @@index([riskId])
  @@index([status])
  @@index([type])
  @@index([leadAuditorId])
  @@index([title])
}

enum TeamMemberRole {
  LEAD_AUDITOR
  AUDITOR
  OBSERVER
  SUBJECT_MATTER_EXPERT
  REVIEWER
}

model EngagementTeamMember {
  engagementId String         @db.Uuid
  userId       String         @db.Uuid
  role         TeamMemberRole @default(AUDITOR)
  assignedAt   DateTime       @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  user       User       @relation("EngagementTeamMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([engagementId, userId])
  @@index([userId])
}
